{
  "name": "xml3-duration-checker",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.spa.config.ts",
    "build": "vite build --config vite.spa.config.ts",
    "build:web": "node scripts/build-releases.mjs",
    "build:offline": "node scripts/build-releases.mjs",
    "preview": "vite preview --config vite.spa.config.ts",
    "lint": "eslint src spa scripts --no-cache",
    "format": "prettier --write src spa scripts",
    "check:logic": "node --experimental-strip-types scripts/check-xml3-duration.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16"
  }
}
